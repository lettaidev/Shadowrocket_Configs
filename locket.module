#!name=Locket
#!desc=Locket
[Script]
revenuecat=type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=-1,timeout=60,script-path=https://raw.githubusercontent.com/lettaidev/Shadowrocket_Configs/refs/heads/main/revenuecat.js

deleteHeader = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/lettaidev/Shadowrocket_Configs/refs/heads/main/deleteHeader.js,timeout=60
[MITM]
hostname = %APPEND% api.revenuecat.com